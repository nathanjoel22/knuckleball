# Cloudflare Pages header rules (copied into _site/ by scripts/build-site.sh).
# The service worker and every page are revalidated on every request, so a deploy reaches devices on their next load
# (sw.js must never sit in a cache: a stale worker strands installed apps on old code -- CLAUDE.md landmine 9).
# Pages are listed one by one, with and without .html: Cloudflare Pages serves /page.html as /page by default.
/sw.js
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/index
  Cache-Control: no-cache

